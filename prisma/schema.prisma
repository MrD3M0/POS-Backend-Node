generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHERS
}

enum Role {
  ADMIN
  PRINCIPAL
  ACCOUNTANT
  TEACHER
  STAFF
  STUDENT
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum CourseSystem {
  SEMESTER
  YEARLY
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  DROPPED
  SUSPENDED
}

// Admin approval of a new student (added by teacher, approved by admin)
enum StudentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Teacher creates (DRAFT/PENDING), Principal approves, then PUBLISHED
enum ResultStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

// Accountant prepares (DRAFT/PENDING), Principal approves, then PAID
enum PayrollStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

// Salary factor lives in code, not DB: PRESENT = 1, HALF_DAY = 0.5, ABSENT = 0,
// LEAVE = 1 if LeaveType.isPaid else 0
enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

// Normal balance lives in code: ASSET and EXPENSE = debit, the rest = credit
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Which module created the journal entry
enum JournalSource {
  MANUAL
  FEE_PAYMENT
  FEE_PAYMENT_CANCEL
  PAYROLL
  OPENING
  REVERSAL
  CLOSING
}

// =====================================================================
// 1. USERS AND PEOPLE
// =====================================================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  username         String?   @unique
  passwordHash     String
  role             Role
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  otps     Otp[]
  employee Employee?
  student  Student?

  @@map("users")
}

// Store only a hash of the code (e.g. HMAC-SHA256), never the plain OTP.
model Otp {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0) // wrong guesses, lock the OTP after N
  expiresAt  DateTime
  consumedAt DateTime? // set when used, so it can never be reused
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt]) // cleanup job
  @@map("otps")
}

// Common HR data for Principal / Teacher / Staff / Accountant.
// Attendance, salary and payroll all point here (one FK instead of four).
model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @unique @db.Uuid
  employeeCode     String    @unique
  firstName        String
  middleName       String?
  lastName         String
  gender           Gender
  dobBs            String?   @db.VarChar(10)
  phone            String?
  email            String?
  permanentAddress String?
  temporaryAddress String?
  photoUrl         String?
  designation      String
  joinDateBs       String    @db.VarChar(10)
  leaveDateBs      String?   @db.VarChar(10)
  panNo            String?   @unique
  ssfNo            String?   @unique
  bankName         String?
  bankAccountNo    String? // sensitive: encrypt at application level
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  principal  Principal?
  teacher    Teacher?
  accountant Accountant?
  staff      Staff?

  attendances      EmployeeAttendance[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]
  journalLines     JournalLine[]

  @@map("employees")
}

model Principal {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @unique @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("principals")
}

model Accountant {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @unique @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("accountants")
}

model Staff {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @unique @db.Uuid
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  deletedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("staffs")
}

model Teacher {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @unique @db.Uuid
  qualification  String?
  specialization String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  deletedAt      DateTime?

  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignments TeachingAssignment[]
  sessions    AttendanceSession[]

  @@map("teachers")
}

model Student {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @unique @db.Uuid // students do not log in, so optional
  universityRegNo  String    @unique
  firstName        String
  middleName       String?
  lastName         String
  gender           Gender
  dobBs            String?   @db.VarChar(10)
  phone            String?
  email            String?
  permanentAddress String?
  temporaryAddress String?
  photoUrl         String?
  batchId          String    @db.Uuid
  admissionDateBs  String    @db.VarChar(10)
  status           StudentStatus         @default(ACTIVE)
  // admin approval: student is only "real" after APPROVED
  approvalStatus   StudentApprovalStatus @default(PENDING)
  approvedBy       String?   @db.Uuid
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid // teacher who added the student
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  guardians    Guardian[]
  attendances  StudentAttendance[]
  marks        ExamMark[]
  results      Result[]
  fees         StudentFee[]
  payments     FeePayment[]
  journalLines JournalLine[]

  @@index([batchId])
  @@index([approvalStatus])
  @@index([status])
  @@map("students")
}

model Guardian {
  id         String    @id @default(uuid()) @db.Uuid
  studentId  String    @db.Uuid
  relation   GuardianRelation
  fullName   String
  phone      String?
  email      String?
  occupation String?
  address    String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  deletedAt  DateTime?

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("guardians")
}

// =====================================================================
// 2. LOOKUP TABLES (admin CRUD, seed these)
// =====================================================================

model LeaveType {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique // SICK, CASUAL, HOME, UNPAID, ...
  name          String
  isPaid        Boolean   @default(true)
  yearlyAllowed Int? // days per year, null = unlimited
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime?

  employeeAttendances EmployeeAttendance[]

  @@map("leave_types")
}

model Period {
  id           String    @id @default(uuid()) @db.Uuid
  periodNumber Int       @unique
  name         String // "Period 1"
  startTime    String    @db.VarChar(5) // "10:00"
  endTime      String    @db.VarChar(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime?

  sessions AttendanceSession[]

  @@map("periods")
}

// Admin CRUD. Only terminal exams, but kept as lookup as requested
model ExamType {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique // FIRST_TERMINAL, SECOND_TERMINAL, ...
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  exams Exam[]

  @@map("exam_types")
}

// 4.0 scale: A=4.0, A-=3.7, ... F=0 (seed according to university rule)
model GradeScale {
  id          String    @id @default(uuid()) @db.Uuid
  grade       String    @unique // "A", "A-", "B+", ...
  minPercent  Decimal   @db.Decimal(5, 2)
  maxPercent  Decimal   @db.Decimal(5, 2)
  gradePoint  Decimal   @db.Decimal(3, 2)
  description String?
  isPassGrade Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  resultSubjects ResultSubject[]

  @@map("grade_scales")
}

model FeeHead {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique // ADMISSION, TUITION, EXAM, LAB, LIBRARY, ...
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  structureItems FeeStructureItem[]
  studentItems   StudentFeeItem[]

  @@map("fee_heads")
}

// CASH, BANK, CHEQUE, ESEWA, KHALTI (manual record only, no gateway)
// accountId = ledger account that gets debited when money comes in through this method
model PaymentMethod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  name      String
  accountId String?   @db.Uuid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  account      Account?               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentLines FeePaymentMethodLine[]
  payslips     Payslip[]

  @@index([accountId])
  @@map("payment_methods")
}

// BASIC, HRA, DEARNESS, SSF_EMPLOYEE, SSF_EMPLOYER, PF, CIT, TDS, ADVANCE, ...
model SalaryComponent {
  id                     String    @id @default(uuid()) @db.Uuid
  code                   String    @unique
  name                   String
  isDeduction            Boolean   @default(false)
  isEmployerContribution Boolean   @default(false) // e.g. employer SSF, not deducted from net pay
  isTaxable              Boolean   @default(true)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?   @db.Uuid
  updatedBy              String?   @db.Uuid
  deletedAt              DateTime?

  structureItems SalaryStructureItem[]
  payslipItems   PayslipItem[]

  @@map("salary_components")
}

// =====================================================================
// 3. ACADEMIC STRUCTURE (Course -> Batch -> BatchTerm -> BatchTermSubject)
// =====================================================================

model Course {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique // BIT, BBA, ...
  name           String
  system         CourseSystem
  totalTerms     Int // semester system: 8, yearly system: 4
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  deletedAt      DateTime?

  batches       Batch[]
  feeStructures FeeStructure[]

  @@map("courses")
}

model Batch {
  id                String    @id @default(uuid()) @db.Uuid
  courseId          String    @db.Uuid
  name              String // "2080"
  startDateBs       String?   @db.VarChar(10)
  currentTermNumber Int       @default(1) // which semester / year this batch is in now
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
  deletedAt         DateTime?

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  terms         BatchTerm[]
  students      Student[]
  feeStructures FeeStructure[]
  noticeTargets NoticeTarget[]

  @@unique([courseId, name])
  @@map("batches")
}

// One row per semester/year of a batch: Batch 2080 -> Semester 1..8
model BatchTerm {
  id          String    @id @default(uuid()) @db.Uuid
  batchId     String    @db.Uuid
  termNumber  Int
  name        String // "Semester 1" / "Year 1"
  startDateBs String?   @db.VarChar(10)
  endDateBs   String?   @db.VarChar(10)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  batch    Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  subjects BatchTermSubject[]
  exams    Exam[]

  @@unique([batchId, termNumber])
  @@map("batch_terms")
}

model Subject {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  batchTermSubjects BatchTermSubject[]

  @@map("subjects")
}

// Subject list + credit hour of a batch's semester/year.
// Syllabus changes only affect the batch you edit, old batches stay untouched.
model BatchTermSubject {
  id          String    @id @default(uuid()) @db.Uuid
  batchTermId String    @db.Uuid
  subjectId   String    @db.Uuid
  creditHour  Decimal   @db.Decimal(4, 1)
  isElective  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  batchTerm    BatchTerm            @relation(fields: [batchTermId], references: [id], onDelete: Restrict)
  subject      Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignments  TeachingAssignment[]
  examSubjects ExamSubject[]

  @@unique([batchTermId, subjectId])
  @@index([subjectId])
  @@map("batch_term_subjects")
}

// Teacher <-> (batch + term + subject). One teacher can have many.
model TeachingAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  teacherId          String    @db.Uuid
  batchTermSubjectId String    @db.Uuid
  assignedDateBs     String    @db.VarChar(10)
  endDateBs          String?   @db.VarChar(10)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?   @db.Uuid
  updatedBy          String?   @db.Uuid
  deletedAt          DateTime?

  teacher          Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  batchTermSubject BatchTermSubject    @relation(fields: [batchTermSubjectId], references: [id], onDelete: Restrict)
  sessions         AttendanceSession[]
  pays             TeacherBatchPay[]

  @@unique([teacherId, batchTermSubjectId])
  @@index([batchTermSubjectId])
  @@map("teaching_assignments")
}

// Batch-wise pay for a teacher (payroll adds this on top of base salary).
// Use ratePerCreditHour OR fixedMonthlyAmount. History kept by effective dates.
model TeacherBatchPay {
  id                   String    @id @default(uuid()) @db.Uuid
  teachingAssignmentId String    @db.Uuid
  ratePerCreditHour    Decimal?  @db.Decimal(14, 2)
  fixedMonthlyAmount   Decimal?  @db.Decimal(14, 2)
  effectiveFromBs      String    @db.VarChar(10)
  effectiveToBs        String?   @db.VarChar(10)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  deletedAt            DateTime?

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)

  @@index([teachingAssignmentId])
  @@map("teacher_batch_pays")
}

// =====================================================================
// 4. ATTENDANCE
// =====================================================================

// One class of one period on one day, taken by a teacher.
model AttendanceSession {
  id                   String    @id @default(uuid()) @db.Uuid
  teachingAssignmentId String    @db.Uuid
  teacherId            String    @db.Uuid // who actually took it (can differ from assignment teacher)
  periodId             String    @db.Uuid
  dateBs               String    @db.VarChar(10)
  isLocked             Boolean   @default(false) // set after edit time limit (see Setting ATTENDANCE_EDIT_HOURS)
  lockedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  deletedAt            DateTime?

  teachingAssignment TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  teacher            Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  period             Period              @relation(fields: [periodId], references: [id], onDelete: Restrict)
  records            StudentAttendance[]

  @@unique([teachingAssignmentId, periodId, dateBs])
  @@index([dateBs])
  @@index([teacherId, dateBs])
  @@index([periodId])
  @@map("attendance_sessions")
}

model StudentAttendance {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  studentId String    @db.Uuid
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("student_attendances")
}

// Teacher / Staff / Accountant attendance, marked by Principal.
// createdBy = the Principal's userId. Payroll reads this table.
model EmployeeAttendance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  dateBs      String    @db.VarChar(10)
  status      AttendanceStatus
  leaveTypeId String?   @db.Uuid // only when status = LEAVE
  remarks     String?
  isLocked    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType?       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, dateBs])
  @@index([dateBs])
  @@index([status])
  @@index([leaveTypeId])
  @@map("employee_attendances")
}

// =====================================================================
// 5. EXAM AND RESULT (terminal exams only, no back paper)
// =====================================================================

model Exam {
  id          String    @id @default(uuid()) @db.Uuid
  batchTermId String    @db.Uuid
  examTypeId  String    @db.Uuid
  name        String
  startDateBs String?   @db.VarChar(10)
  endDateBs   String?   @db.VarChar(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid // teacher
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  batchTerm BatchTerm     @relation(fields: [batchTermId], references: [id], onDelete: Restrict)
  examType  ExamType      @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  subjects  ExamSubject[]
  results   Result[]

  @@index([batchTermId])
  @@index([examTypeId])
  @@map("exams")
}

model ExamSubject {
  id                 String    @id @default(uuid()) @db.Uuid
  examId             String    @db.Uuid
  batchTermSubjectId String    @db.Uuid
  fullMarks          Decimal   @default(100) @db.Decimal(6, 2)
  passMarks          Decimal   @default(40) @db.Decimal(6, 2)
  examDateBs         String?   @db.VarChar(10)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?   @db.Uuid
  updatedBy          String?   @db.Uuid
  deletedAt          DateTime?

  exam             Exam             @relation(fields: [examId], references: [id], onDelete: Restrict)
  batchTermSubject BatchTermSubject @relation(fields: [batchTermSubjectId], references: [id], onDelete: Restrict)
  marks            ExamMark[]
  resultSubjects   ResultSubject[]

  @@unique([examId, batchTermSubjectId])
  @@index([batchTermSubjectId])
  @@map("exam_subjects")
}

model ExamMark {
  id            String    @id @default(uuid()) @db.Uuid
  examSubjectId String    @db.Uuid
  studentId     String    @db.Uuid
  marksObtained Decimal?  @db.Decimal(6, 2)
  isAbsent      Boolean   @default(false)
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime?

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

// Per-student result of one exam. Teacher creates (PENDING), Principal approves.
// GPA = sum(gradePoint * creditHour) / sum(creditHour)  (credit-weighted, 4.0 scale)
model Result {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @db.Uuid
  examId           String    @db.Uuid
  totalMarks       Decimal   @db.Decimal(8, 2)
  fullMarks        Decimal   @db.Decimal(8, 2)
  percentage       Decimal   @db.Decimal(5, 2)
  totalCreditHour  Decimal   @db.Decimal(5, 1)
  gpa              Decimal   @db.Decimal(3, 2)
  cgpa             Decimal?  @db.Decimal(3, 2)
  isPassed         Boolean
  status           ResultStatus @default(PENDING)
  submittedAt      DateTime?
  approvedBy       String?   @db.Uuid // Principal userId
  approvedAt       DateTime?
  publishedAt      DateTime?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  subjects       ResultSubject[]

  @@unique([studentId, examId])
  @@index([examId])
  @@index([status])
  @@map("results")
}

// Snapshot per subject (creditHour copied so later syllabus edits never change old results)
model ResultSubject {
  id            String    @id @default(uuid()) @db.Uuid
  resultId      String    @db.Uuid
  examSubjectId String    @db.Uuid
  marksObtained Decimal   @db.Decimal(6, 2)
  fullMarks     Decimal   @db.Decimal(6, 2)
  creditHour    Decimal   @db.Decimal(4, 1)
  gradeScaleId  String    @db.Uuid
  gradePoint    Decimal   @db.Decimal(3, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime?

  result      Result      @relation(fields: [resultId], references: [id], onDelete: Restrict)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)
  gradeScale  GradeScale  @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)

  @@unique([resultId, examSubjectId])
  @@index([examSubjectId])
  @@index([gradeScaleId])
  @@map("result_subjects")
}

// =====================================================================
// 6. FEE MANAGEMENT
// =====================================================================

// Accountant creates per course (optionally per batch, null batch = default for course)
model FeeStructure {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @db.Uuid
  batchId   String?   @db.Uuid
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch       Batch?             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  items       FeeStructureItem[]
  studentFees StudentFee[]

  @@index([courseId])
  @@index([batchId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String    @id @default(uuid()) @db.Uuid
  feeStructureId String    @db.Uuid
  feeHeadId      String    @db.Uuid
  termNumber     Int? // null = one time (e.g. admission)
  amount         Decimal   @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  deletedAt      DateTime?

  feeStructure FeeStructure     @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  feeHead      FeeHead          @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
  studentItems StudentFeeItem[]

  @@unique([feeStructureId, feeHeadId, termNumber]) // one-time rows (termNumber NULL): see SQL file
  @@index([feeHeadId])
  @@map("fee_structure_items")
}

// Fee assigned to one student (copied from structure at admission by Accountant).
// Discount / skip / custom item all live in StudentFeeItem, so fee can differ per student.
model StudentFee {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @db.Uuid
  feeStructureId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  deletedAt      DateTime?

  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeStructure FeeStructure?    @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  items        StudentFeeItem[]

  @@index([studentId])
  @@index([feeStructureId])
  @@map("student_fees")
}

model StudentFeeItem {
  id                 String    @id @default(uuid()) @db.Uuid
  studentFeeId       String    @db.Uuid
  feeHeadId          String    @db.Uuid
  feeStructureItemId String?   @db.Uuid // null = custom item added for this student
  termNumber         Int?
  description        String?
  amount             Decimal   @db.Decimal(14, 2)
  discountAmount     Decimal   @default(0) @db.Decimal(14, 2)
  discountReason     String?
  netAmount          Decimal   @db.Decimal(14, 2) // amount - discountAmount
  isSkipped          Boolean   @default(false) // Accountant can skip a fee for a student
  skipReason         String?
  dueDateBs          String?   @db.VarChar(10)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?   @db.Uuid
  updatedBy          String?   @db.Uuid
  deletedAt          DateTime?

  studentFee       StudentFee             @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)
  feeHead          FeeHead                @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
  feeStructureItem FeeStructureItem?      @relation(fields: [feeStructureItemId], references: [id], onDelete: SetNull)
  installments     FeeInstallment[]
  allocations      FeePaymentAllocation[]

  @@unique([studentFeeId, feeStructureItemId]) // same structure item cannot be copied twice (custom items = NULL, allowed)
  @@index([feeHeadId])
  @@index([feeStructureItemId])
  @@index([dueDateBs])
  @@map("student_fee_items")
}

// Payment schedule if the student pays in installments
model FeeInstallment {
  id               String    @id @default(uuid()) @db.Uuid
  studentFeeItemId String    @db.Uuid
  installmentNo    Int
  dueDateBs        String    @db.VarChar(10)
  amount           Decimal   @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  studentFeeItem StudentFeeItem         @relation(fields: [studentFeeItemId], references: [id], onDelete: Restrict)
  allocations    FeePaymentAllocation[]

  @@unique([studentFeeItemId, installmentNo])
  @@index([dueDateBs])
  @@map("fee_installments")
}

// Money received = one receipt. Append-only: cancel by reversal, never delete.
model FeePayment {
  id             String    @id @default(uuid()) @db.Uuid
  receiptNo      String    @unique
  studentId      String    @db.Uuid
  fiscalYearId   String    @db.Uuid
  paymentDateBs  String    @db.VarChar(10)
  totalAmount    Decimal   @db.Decimal(14, 2)
  remarks        String?
  isCancelled    Boolean   @default(false)
  cancelledAt    DateTime?
  cancelReason   String?
  journalEntryId String?   @unique @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid // accountant
  updatedBy      String?   @db.Uuid

  student      Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  methodLines  FeePaymentMethodLine[]
  allocations  FeePaymentAllocation[]

  @@index([studentId])
  @@index([fiscalYearId])
  @@index([paymentDateBs])
  @@map("fee_payments")
}

// Split payment: e.g. 5000 cash + 5000 bank in one receipt
// sum(methodLines.amount) must equal FeePayment.totalAmount
model FeePaymentMethodLine {
  id              String   @id @default(uuid()) @db.Uuid
  feePaymentId    String   @db.Uuid
  paymentMethodId String   @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  referenceNo     String? // cheque no / transaction id
  bankName        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid

  feePayment    FeePayment    @relation(fields: [feePaymentId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([feePaymentId])
  @@index([paymentMethodId])
  @@map("fee_payment_method_lines")
}

// Which fee item / installment this payment pays (supports partial payment)
model FeePaymentAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  feePaymentId     String   @db.Uuid
  studentFeeItemId String   @db.Uuid
  feeInstallmentId String?  @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?  @db.Uuid
  updatedBy        String?  @db.Uuid

  feePayment     FeePayment      @relation(fields: [feePaymentId], references: [id], onDelete: Restrict)
  studentFeeItem StudentFeeItem  @relation(fields: [studentFeeItemId], references: [id], onDelete: Restrict)
  feeInstallment FeeInstallment? @relation(fields: [feeInstallmentId], references: [id], onDelete: Restrict)

  @@index([feePaymentId])
  @@index([studentFeeItemId])
  @@index([feeInstallmentId])
  @@map("fee_payment_allocations")
}

// =====================================================================
// 7. ACCOUNTING (double entry)
// =====================================================================

model FiscalYear {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique // "2081/82"
  startDateBs String    @db.VarChar(10) // 2081-04-01 (Shrawan 1)
  endDateBs   String    @db.VarChar(10)
  isCurrent   Boolean   @default(false)
  isClosed    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  journalEntries JournalEntry[]
  payments       FeePayment[]
  payrolls       Payroll[]
  taxSlabs       TaxSlab[]

  @@map("fiscal_years")
}

// Chart of accounts (tree). isGroup = heading only, cannot receive postings.
model Account {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  type          AccountType
  parentId      String?   @db.Uuid
  isGroup       Boolean   @default(false)
  isSystem      Boolean   @default(false) // seeded accounts that must not be removed
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime?

  parent         Account?        @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Account[]       @relation("AccountTree")
  journalLines   JournalLine[]
  paymentMethods PaymentMethod[]

  @@index([type])
  @@index([parentId])
  @@map("accounts")
}

// Append-only. No deletedAt on purpose. Correct mistakes with a reversal entry.
// Manual / backdated entries: dateBs can be in the past (isBackdated = true).
model JournalEntry {
  id           String   @id @default(uuid()) @db.Uuid
  entryNo      String   @unique // JV-2081/82-000123
  fiscalYearId String   @db.Uuid
  dateBs       String   @db.VarChar(10)
  description  String
  source       JournalSource
  sourceRefId  String?  @db.Uuid // id of FeePayment / Payroll / ... that created it
  isManual     Boolean  @default(false)
  isBackdated  Boolean  @default(false)
  isReversed   Boolean  @default(false)
  reversalOfId String?  @unique @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid
  updatedBy    String?  @db.Uuid

  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("Reversal")
  lines      JournalLine[]
  feePayment FeePayment?
  payroll    Payroll?

  @@index([fiscalYearId, dateBs])
  @@index([source, sourceRefId])
  @@map("journal_entries")
}

// Each entry: sum(debit) = sum(credit) and each line has debit XOR credit.
// Prisma cannot express CHECK constraints, add them with constraints.sql (run after `prisma migrate`).
model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @db.Uuid
  accountId      String   @db.Uuid
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  description    String?
  studentId      String?  @db.Uuid // optional party, gives student ledger
  employeeId     String?  @db.Uuid // optional party, gives employee ledger
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([studentId])
  @@index([employeeId])
  @@map("journal_lines")
}

// =====================================================================
// 8. PAYROLL (Nepal rules: SSF / PF / CIT / TDS as SalaryComponent + TaxSlab)
// =====================================================================

// Salary is versioned: when salary changes, close the old row (effectiveToBs)
// and create a new one. Old payslips keep their own snapshot.
model SalaryStructure {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  basicSalary     Decimal   @db.Decimal(14, 2)
  effectiveFromBs String    @db.VarChar(10)
  effectiveToBs   String?   @db.VarChar(10)
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?   @db.Uuid
  updatedBy       String?   @db.Uuid
  deletedAt       DateTime?

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    SalaryStructureItem[]

  @@index([employeeId, effectiveFromBs])
  @@map("salary_structures")
}

model SalaryStructureItem {
  id                String    @id @default(uuid()) @db.Uuid
  salaryStructureId String    @db.Uuid
  componentId       String    @db.Uuid
  amount            Decimal   @db.Decimal(14, 2)
  isPercentOfBasic  Boolean   @default(false) // amount = percent when true
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
  deletedAt         DateTime?

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([salaryStructureId, componentId])
  @@index([componentId])
  @@map("salary_structure_items")
}

// Income tax slabs per fiscal year (fill from that year's budget)
model TaxSlab {
  id           String    @id @default(uuid()) @db.Uuid
  fiscalYearId String    @db.Uuid
  isCouple     Boolean   @default(false)
  fromAmount   Decimal   @db.Decimal(14, 2)
  toAmount     Decimal?  @db.Decimal(14, 2)
  ratePercent  Decimal   @db.Decimal(5, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime?

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([fiscalYearId, isCouple, fromAmount])
  @@map("tax_slabs")
}

// Monthly payroll run: Accountant prepares (PENDING), Principal approves, then PAID
model Payroll {
  id               String    @id @default(uuid()) @db.Uuid
  fiscalYearId     String    @db.Uuid
  yearBs           Int
  monthBs          Int // 1 = Baisakh ... 12 = Chaitra
  totalDays        Int
  status           PayrollStatus @default(DRAFT)
  submittedAt      DateTime?
  approvedBy       String?   @db.Uuid // Principal userId
  approvedAt       DateTime?
  paidDateBs       String?   @db.VarChar(10)
  journalEntryId   String?   @unique @db.Uuid
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?   @db.Uuid // accountant
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  payslips       Payslip[]

  @@unique([yearBs, monthBs])
  @@index([fiscalYearId])
  @@index([status])
  @@map("payrolls")
}

// Stored payslip (snapshot). Attendance summary is copied so it never changes later.
model Payslip {
  id                  String   @id @default(uuid()) @db.Uuid
  payslipNo           String   @unique
  payrollId           String   @db.Uuid
  employeeId          String   @db.Uuid
  presentDays         Decimal  @db.Decimal(5, 2)
  halfDays            Int      @default(0)
  paidLeaveDays       Int      @default(0)
  unpaidLeaveDays     Int      @default(0)
  absentDays          Int      @default(0)
  basicSalary         Decimal  @db.Decimal(14, 2)
  attendanceDeduction Decimal  @default(0) @db.Decimal(14, 2) // salary cut for absent / unpaid leave
  totalAllowance      Decimal  @default(0) @db.Decimal(14, 2)
  teachingPay         Decimal  @default(0) @db.Decimal(14, 2) // from TeacherBatchPay
  grossPay            Decimal  @db.Decimal(14, 2)
  totalDeduction      Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal  @default(0) @db.Decimal(14, 2)
  netPay              Decimal  @db.Decimal(14, 2)
  paymentMethodId     String?  @db.Uuid
  paidDateBs          String?  @db.VarChar(10)
  pdfUrl              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?  @db.Uuid
  updatedBy           String?  @db.Uuid

  payroll       Payroll        @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  items         PayslipItem[]

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([paymentMethodId])
  @@map("payslips")
}

model PayslipItem {
  id                     String   @id @default(uuid()) @db.Uuid
  payslipId              String   @db.Uuid
  componentId            String?  @db.Uuid
  description            String
  amount                 Decimal  @db.Decimal(14, 2)
  isDeduction            Boolean  @default(false)
  isEmployerContribution Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String?  @db.Uuid
  updatedBy              String?  @db.Uuid

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  component SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([payslipId])
  @@index([componentId])
  @@map("payslip_items")
}

// =====================================================================
// 9. NOTICE + SETTINGS
// =====================================================================

model Notice {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  body          String
  attachmentUrl String?
  isPinned      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  expiresOnBs   String?   @db.VarChar(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime?

  targets NoticeTarget[]

  @@index([isPublished, publishedAt])
  @@map("notices")
}

// Who sees the notice: a role, a batch, or both. No targets = everyone.
model NoticeTarget {
  id        String    @id @default(uuid()) @db.Uuid
  noticeId  String    @db.Uuid
  role      Role?
  batchId   String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  batch  Batch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([noticeId])
  @@index([batchId])
  @@map("notice_targets")
}

// Key/value config, e.g. ATTENDANCE_EDIT_HOURS = 24, WORKING_DAYS_MODE = CALENDAR
model Setting {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime?

  @@map("settings")
}

